# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual env
.venv/
venv/
env/

# Claude Code runtime
.claude/cache/
.claude/sessions/
.claude/state/

# Working files (intermediate outputs, test artifacts)
work/
!work/.gitkeep

# Session snapshots (saved work/ states for switching between projects)
sessions/

# Tests — inputs are archived by scripts/session_save.sh into sessions/*.zip,
# so the whole tests/ tree is per-deck and does not belong in git.
tests/

# Per-deck scripts + patches (regenerated per deck; wiped by scripts/reset.sh).
# Rule: everything under scripts/ is per-deck EXCEPT *.sh (tracked tooling).
scripts/**
!scripts/**/*.sh

# IDE
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
*.key
